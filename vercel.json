{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.beneficiodiario.com" }], "destination": "https://beneficiodiario.com/:path*", "permanent": true },
    { "source": "/blog/beneficiodiario-comunidad-abstract-espanol", "destination": "/airdrops", "permanent": true },
    { "source": "/en/blog/beneficiodiario-comunidad-abstract-espanol", "destination": "/en", "permanent": true },
    { "source": "/blog/markets-hyperliquid-app", "destination": "/perp-dex", "permanent": true },
    { "source": "/en/blog/markets-hyperliquid-app", "destination": "/en", "permanent": true }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    { "source": "/assets/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/404", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] }
  ]
}
