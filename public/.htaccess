# BeneficioDiario — configuración para IONOS (Apache)

# Evita que Apache invente variantes de URL o liste directorios.
Options -MultiViews -Indexes
# No añadir barra final automática a las carpetas (lo gestionamos nosotros).
DirectorySlash Off
# Servir texto siempre como UTF-8.
AddDefaultCharset UTF-8

# ════════════════════════════════════════════════════════════════
#  ROUTING / REDIRECCIONES
# ════════════════════════════════════════════════════════════════
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Host canónico (sin www) + HTTPS en un solo salto.
  #    www.beneficiodiario.com/x  ->  https://beneficiodiario.com/x
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # IONOS termina el SSL en su proxy → comprobamos X-Forwarded-Proto para no
  # entrar en bucle de redirección.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2) Una sola forma canónica: SIN barra final (salvo la raíz "/").
  #    /blog/slug/  ->  /blog/slug   (la misma URL del sitemap y el canonical)
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # 3) Página prerenderizada (/blog/slug, /en, /en/blog/slug, /privacidad...):
  #    servir su index.html SIN redirigir → la URL sin barra responde 200 directo.
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ %{REQUEST_URI}/index.html [L]

  # 4) Archivo existente (assets con hash, imágenes, sitemap, robots, ads.txt...):
  #    servir tal cual.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 5) Resto (la raíz y cualquier ruta de React Router) -> index.html.
  RewriteRule ^ /index.html [L]
</IfModule>

# ════════════════════════════════════════════════════════════════
#  CABECERAS DE SEGURIDAD
# ════════════════════════════════════════════════════════════════
<IfModule mod_headers.c>
  # No adivinar el tipo de contenido (anti MIME-sniffing).
  Header always set X-Content-Type-Options "nosniff"
  # Evitar que la web se embeba en iframes de terceros (anti clickjacking).
  Header always set X-Frame-Options "SAMEORIGIN"
  # Enviar solo el origen como referente entre dominios.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Desactivar APIs del navegador que la web no usa (no tocamos las que AdSense
  # pueda necesitar, p. ej. browsing-topics).
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Forzar HTTPS en el navegador durante 1 año (la web ya redirige a HTTPS).
  Header always set Strict-Transport-Security "max-age=31536000"

  # Cache: los assets llevan hash en el nombre → inmutables y cacheables 1 año.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # El HTML nunca se cachea de forma persistente (para ver cambios al actualizar).
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ════════════════════════════════════════════════════════════════
#  COMPRESIÓN (rendimiento)
# ════════════════════════════════════════════════════════════════
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml \
    image/svg+xml application/rss+xml
</IfModule>

# ════════════════════════════════════════════════════════════════
#  CACHEO DE IMÁGENES (mod_expires)
# ════════════════════════════════════════════════════════════════
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
</IfModule>
